# Canonical local development environment for the Next.js app.
# Copy to apps/web/.env (never commit the real file).
# Deployed environments (Vercel, etc.) set these via the hosting provider dashboard.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ORGANIZATION_SLUG=carepoint-clinic

NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Server-only. Must match the API hosting env exactly. Never prefix with NEXT_PUBLIC_.
# Used only by Next.js Route Handlers as: Authorization: Bearer <key>
APPOINTMENT_TRACKING_API_KEY=replace-with-a-long-random-secret

# Preferred server-to-server NestJS base URL for Route Handlers.
# Production example:
# INTERNAL_API_URL=https://voice-agent-mu9zvc6rl-rajibduet02-gmailcoms-projects.vercel.app
# Falls back to NEXT_PUBLIC_API_URL when unset.
INTERNAL_API_URL=http://localhost:4000
