# Frontend container runtime environment (server-only values).
# NEXT_PUBLIC_* values are baked in at image build time via Compose build args.
# Copy to apps/web/.env.production. Never commit real secrets.

NODE_ENV=production

# Server-only. Must match apps/api/.env.production. Never prefix with NEXT_PUBLIC_.
APPOINTMENT_TRACKING_API_KEY=replace-with-a-long-random-secret

# Optional Docker-internal API base for server-side routes (calendar proxy).
# Browser clients still use the baked-in NEXT_PUBLIC_API_URL (HTTPS public domain).
INTERNAL_API_URL=http://api:4000
