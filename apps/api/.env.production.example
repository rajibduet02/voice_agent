# Backend runtime environment for the API container.
# Copy to apps/api/.env.production. Never commit real secrets.

NODE_ENV=production
PORT=4000

# Use the Compose service hostname `postgres` (not localhost).
DATABASE_URL=postgresql://voice_agent:replace-with-strong-password@postgres:5432/voice_agent?schema=public

FRONTEND_URL=https://voice.example.com
PUBLIC_API_URL=https://api.example.com

VAPI_PRIVATE_KEY=
VAPI_CREDENTIAL_ID=
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-secret
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_ASSISTANT_NAME=CarePoint Appointment Assistant
VAPI_ASSISTANT_ID=

# Must match apps/web/.env.production. Never use a NEXT_PUBLIC_ prefix.
APPOINTMENT_TRACKING_API_KEY=replace-with-a-long-random-secret

MINIMUM_BOOKING_LEAD_MINUTES=30

# Production must use HTTPS. Keep these false.
ALLOW_INSECURE_PUBLIC_API_URL=false
ALLOW_INSECURE_VAPI_CREDENTIAL_TRANSPORT=false
SKIP_PUBLIC_API_PREFLIGHT=false
