NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/voice_agent?schema=public
FRONTEND_URL=http://localhost:3000

# Backend-only Vapi secrets and provisioning settings
VAPI_PRIVATE_KEY=
VAPI_CREDENTIAL_ID=
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-secret
VAPI_API_BASE_URL=https://api.vapi.ai
PUBLIC_API_URL=
VAPI_ASSISTANT_NAME=CarePoint Appointment Assistant
VAPI_ASSISTANT_ID=

# Temporary development-only overrides (default false). Never enable in production.
# ALLOW_INSECURE_PUBLIC_API_URL=true allows a publicly routable HTTP IP in development.
# ALLOW_INSECURE_VAPI_CREDENTIAL_TRANSPORT=true is required if that HTTP URL also uses VAPI_CREDENTIAL_ID.
# SKIP_PUBLIC_API_PREFLIGHT=true skips GET ${PUBLIC_API_URL}/health before provisioning (development only).
ALLOW_INSECURE_PUBLIC_API_URL=false
ALLOW_INSECURE_VAPI_CREDENTIAL_TRANSPORT=false
SKIP_PUBLIC_API_PREFLIGHT=false

# Shared with apps/web/.env.local (server-only). Never use a NEXT_PUBLIC_ prefix.
APPOINTMENT_TRACKING_API_KEY=replace-with-a-long-random-secret

# Same-day booking lead time in minutes (default 30).
MINIMUM_BOOKING_LEAD_MINUTES=30
