# Root production deployment variables (used by Docker Compose interpolation).
# Copy to .env.production and fill in real values. Never commit .env.production.

WEB_DOMAIN=voice.example.com
API_DOMAIN=api.example.com

POSTGRES_DB=voice_agent
POSTGRES_USER=voice_agent
POSTGRES_PASSWORD=replace-with-strong-password

# Embedded into the Next.js image at build time (public values only).
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_ORGANIZATION_SLUG=carepoint-clinic
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
